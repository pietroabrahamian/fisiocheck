# Opcional: sem .env o app usa o projeto fisiocheck-fiap (veja src/config/firebase.ts).
# Para usar outro projeto, copie este arquivo para ".env" e preencha com os dados dele
# (Console do Firebase > Configurações do projeto > Seus apps > App da Web > Configuração do SDK)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=seu-projeto
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
